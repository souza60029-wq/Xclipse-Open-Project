flowchart TD
  classDef boundary fill:#0d47a1,color:#fff,stroke:#082f6b,stroke-width:2px
  classDef partial fill:#f9a825,color:#111,stroke:#f57f17,stroke-width:2px
  classDef risk fill:#c62828,color:#fff,stroke:#8e0000,stroke-width:3px
  classDef confirmed fill:#2e7d32,color:#fff,stroke:#1b5e20,stroke-width:2px

  A["Aparelho / Android"]:::boundary --> B["Loader e namespace"]:::partial
  B --> C{"ICD layer visível?"}:::partial
  C -- "não" --> R1["Falha: namespace, manifesto ou permissão"]:::risk
  C -- "sim" --> D["renderD128 e UAPI acessíveis"]:::confirmed
  D --> E{"BO / VA / IOMMU correlacionados?"}:::partial
  E -- "não" --> R2["Falha: mapeamento, cache ou proteção"]:::risk
  E -- "sim" --> F{"CS / IB / fence correlacionados?"}:::partial
  F -- "não" --> R3["Falha: estrutura, alinhamento ou sincronização"]:::risk
  F -- "sim" --> G{"Packet e ISA conhecidos?"}:::partial
  G -- "não" --> R4["Falha: command processor ou encoding"]:::risk
  G -- "sim" --> H{"Readback reproduzível?"}:::partial
  H -- "não" --> R5["Falha: execução, resource ou retire"]:::risk
  H -- "sim" --> I["Caminho técnico reproduzível"]:::confirmed
  B -. "investigar" .-> X1["Root / desbloqueio / SELinux"]:::risk
  B -. "investigar" .-> X2["ICD layers e loader alternativo"]:::risk
  D -. "investigar" .-> X3["Componentes customizados de userspace"]:::risk
